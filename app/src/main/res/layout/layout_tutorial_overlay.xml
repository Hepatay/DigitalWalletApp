<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tutorialOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:elevation="24dp">

    <!-- Custom View that draws the blur and glow -->
    <com.epatay.digitalwallet.ui.tutorial.TutorialCanvasView
        android:id="@+id/tutorialCanvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/tutorialCardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <include
            android:id="@+id/tutorialCard"
            layout="@layout/layout_tutorial_bottom_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />
            
    </FrameLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tvGoldTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/gold_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvGoldNotice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/gold_reference_notice"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoldTitle" />

    <TextView
        android:id="@+id/tvGoldMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="?attr/colorError"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoldNotice"
        tools:text="Son kaydedilen fiyatlar gösteriliyor."
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGoldRates"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="112dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvGoldMessage"
        tools:listitem="@layout/item_gold_rate" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressGold"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:indicatorColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="@id/rvGoldRates"
        app:layout_constraintEnd_toEndOf="@id/rvGoldRates"
        app:layout_constraintStart_toStartOf="@id/rvGoldRates"
        app:layout_constraintTop_toTopOf="@id/rvGoldRates" />

</androidx.constraintlayout.widget.ConstraintLayout>
